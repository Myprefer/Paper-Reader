# OpenAI-compatible API
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Comma-separated model lists shown in the UI
OPENAI_TEXT_MODELS=
OPENAI_DEFAULT_TEXT_MODEL=
OPENAI_IMAGE_MODELS=gpt-image-2
OPENAI_DEFAULT_IMAGE_MODEL=gpt-image-2

# Optional tuning
OPENAI_RATE_LIMIT=20
OPENAI_TIMEOUT=300
OPENAI_STREAM_IDLE_TIMEOUT=120
OPENAI_MAX_PDF_CHARS=300000
